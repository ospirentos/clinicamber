# Production environment for docker-compose.prod.yml.
# Copy to .env on the server (never commit .env) and fill in values.
# Generate fresh secrets with: ./scripts/gen-secrets.sh

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Database (Postgres is only reachable on the internal Docker network)
DATABASE_CLIENT=postgres
DATABASE_HOST=amber-cmsDB
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=amber_cms
DATABASE_PASSWORD=

# Strapi secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Web app
WEB_CMS_BASE_URL=https://cms.clinicamber.com
WEB_API_URL=http://amber-cms-app:1337/api/
# Read-only Strapi API token, created in Strapi admin > Settings > API Tokens
WEB_PUBLIC_TOKEN=
GOOGLE_API_KEY=
GOOGLE_API_KEY_SSR=
GOOGLE_PLACE_ID=ChIJfR4YLP3GyhQRXgfGrO6D_zY

# Mail sender
MAIL_SENDER_URL=http://mail-sender:1338
MAIL_SENDER_USERNAME=randevu@clinicamber.com
MAIL_SENDER_PASSWORD=
MAIL_SENDER_HOST=mail.clinicamber.com
MAIL_SENDER_PORT=465
